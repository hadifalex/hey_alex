# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables
.env

# Speech-to-text model (Vosk): downloaded separately, see README
models/vosk-model-small-en-us-0.15/*
!models/.gitkeep

# Machine-specific config files: copy the *.example.yaml files and edit your copy.
config/*.yaml
!config/audio.example.yaml

# personality profiles: only the default is shared.
profiles/*
!profiles/default/ # keep this one
